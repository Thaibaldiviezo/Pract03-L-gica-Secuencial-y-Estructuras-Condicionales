#include <iostream>
using namespace std;

int main()
{
    int dia;
    int mes;

    cout << "Ingrese dia: ";
    cin >> dia;

    cout << "Ingrese mes: ";
    cin >> mes;

    if((mes == 12 && dia >= 21) || mes == 1 || mes == 2 || (mes == 3 && dia < 21))
    {
        cout << "Verano";
    }

    if((mes == 3 && dia >= 21) || mes == 4 || mes == 5 || (mes == 6 && dia < 21))
    {
        cout << "Otono";
    }

    if((mes == 6 && dia >= 21) || mes == 7 || mes == 8 || (mes == 9 && dia < 21))
    {
        cout << "Invierno";
    }

    if((mes == 9 && dia >= 21) || mes == 10 || mes == 11 || (mes == 12 && dia < 21))
    {
        cout << "Primavera";
    }

    return 0;
}
